// priority: 998

/**
 * 技能标签表
 * 键为技能id，值为该技能的标签数组
 *
 * 标签分类与判定规则：
 *   伤害类型：physical 物理 / magic 法术
 *     - 物理：伤害类型为玩家攻击、生物攻击等物理伤害
 *     - 法术：存在学派（火焰/冰霜/雷霆/自然/猩红/神圣/唤魔/末影）即为法术
 *   攻击形态：melee 近战 / projectile 投射物 / aoe 范围
 *     - 近战：攻击形态为近距离（挥砍、突进撞击、贴脸反击）
 *     - 投射物：技能自身产生飞行的伤害载具实体（火球、箭、血针、飞剑等），
 *       原地生成的力场/尖刺/云雾/召唤物不算投射物
 *     - 范围：一次释放的伤害/生效判定是范围性的（爆炸半径、锥形/扇形判定、
 *       周围或区域选取、连锁弹射、地面云雾落雨、范围增益）
 *       只是「一次放出多枚各自单体命中的投射物」不算范围（如猩红刺狱、火焰追踪弹幕）
 *   学派：fire 火焰 / ice 冰霜 / lightning 雷霆 / nature 自然 / blood 猩红 / holy 神圣 / evocation 唤魔 / ender 末影
 *   功能：buff 增益 / control 控制 / heal 治疗 / summon 召唤 / movement 位移
 *
 * 例：巨型火球 = fire + magic + projectile
 *     蓄力斩   = physical + melee
 *     蓄力箭   = physical + projectile
 */
let SkillToTagObj = {}

// 短id -> 完整id，技能树里用的是 fireball 这类短id，法术表里用的是完整id
let SkillShortIdToFullId = {}

// 标签 -> 技能id列表
let TagToSkillObj = {}

/**
 * 给技能添加标签，重复添加同一个标签不会生效
 * @param {string} skillId 技能id
 * @param {string} tag 标签
 */
function addSkillTag(skillId, tag) {
    if (!skillId || !tag) return
    if (!SkillToTagObj[skillId]) {
        SkillToTagObj[skillId] = []
        let string = skillId.split(":")
        if (string.length === 2) {
            SkillShortIdToFullId[string[1]] = skillId
        }
    }
    let tags = SkillToTagObj[skillId]
    if (tags.includes(tag)) return
    tags.push(tag)

    if (!TagToSkillObj[tag]) {
        TagToSkillObj[tag] = []
    }
    if (!TagToSkillObj[tag].includes(skillId)) {
        TagToSkillObj[tag].push(skillId)
    }

    // 女仆战斗 AI 在 Java 侧，按标签判断「这个技能该在什么情况下放」
    $FastMaid.registerSkillTag(skillId, tag)
}

/**
 * 批量给技能添加标签
 * @param {string} skillId 技能id
 * @param {string[]} tags 标签列表
 */
function addSkillTags(skillId, tags) {
    tags.forEach(tag => {
        addSkillTag(skillId, tag)
    })
}

/**
 * 通过技能id获得全部标签，支持短id（如 fireball）
 * @param {string} skillId 技能id
 * @returns {string[]} 标签列表
 */
function getSkillTags(skillId) {
    if (!skillId) return []
    if (SkillToTagObj[skillId]) return SkillToTagObj[skillId]
    if (SkillShortIdToFullId[skillId]) return SkillToTagObj[SkillShortIdToFullId[skillId]]
    return []
}

/**
 * 通过技能id检测是否拥有指定标签
 * @param {string} skillId 技能id
 * @param {string} tag 标签
 * @returns {boolean}
 */
function hasSkillTag(skillId, tag) {
    return getSkillTags(skillId).includes(tag)
}

/**
 * 通过技能id检测是否拥有其中任意一个标签
 * @param {string} skillId 技能id
 * @param {string[]} tags 标签列表
 * @returns {boolean}
 */
function hasAnySkillTag(skillId, tags) {
    let skillTags = getSkillTags(skillId)
    for (let tag of tags) {
        if (skillTags.includes(tag)) return true
    }
    return false
}

/**
 * 通过技能id检测是否拥有全部标签
 * @param {string} skillId 技能id
 * @param {string[]} tags 标签列表
 * @returns {boolean}
 */
function hasAllSkillTags(skillId, tags) {
    let skillTags = getSkillTags(skillId)
    for (let tag of tags) {
        if (!skillTags.includes(tag)) return false
    }
    return true
}

/**
 * 通过标签获得拥有该标签的全部技能id
 * @param {string} tag 标签
 * @returns {string[]} 技能id列表
 */
function getSkillsByTag(tag) {
    if (!tag) return []
    return TagToSkillObj[tag] || []
}

/**
 * 从skillObj中获取拥有指定标签的技能对象
 * @param {Object} skillObj 技能对象，键为技能id，值为等级
 * @param {string} tag 标签
 * @returns {Object} 筛选后的技能对象
 */
function getSkillObjByTagFromSkillObj(skillObj, tag) {
    if (!skillObj) return {}
    let tagSkillObj = {}
    for (let key in skillObj) {
        if (hasSkillTag(key, tag)) {
            tagSkillObj[key] = skillObj[key]
        }
    }
    return tagSkillObj
}

// 标签的中文显示名，技能描述里的标签行由此生成
let SkillTagNameObj = {
    physical: "物理",
    magic: "法术",
    melee: "近战",
    projectile: "投射物",
    aoe: "范围",
    fire: "火焰",
    ice: "冰霜",
    lightning: "雷霆",
    nature: "自然",
    blood: "猩红",
    holy: "神圣",
    evocation: "唤魔",
    ender: "末影",
    buff: "增益",
    control: "控制",
    heal: "治疗",
    summon: "召唤",
    movement: "位移"
}

// 标签的显示顺序：学派 → 伤害类型 → 攻击形态 → 功能
let SkillTagDisplayOrder = [
    "fire", "ice", "lightning", "nature", "blood", "holy", "evocation", "ender",
    "physical", "magic",
    "melee", "projectile", "aoe",
    "buff", "control", "heal", "summon", "movement"
]

/**
 * 通过技能id获得标签的显示文本，标签按显示顺序排列
 * @param {string} skillId 技能id
 * @param {string} separator 分隔符，默认空格
 * @returns {string} 如 火焰 法术 投射物
 */
function getSkillTagText(skillId, separator) {
    let tags = getSkillTags(skillId)
    if (tags.length === 0) return ""
    let join = separator || " "
    let sortList = tags.slice()
    sortList.sort((a, b) => {
        let ai = SkillTagDisplayOrder.indexOf(a)
        let bi = SkillTagDisplayOrder.indexOf(b)
        if (ai < 0) ai = 999
        if (bi < 0) bi = 999
        return ai - bi
    })
    return sortList.map(tag => SkillTagNameObj[tag] || tag).join(join)
}


