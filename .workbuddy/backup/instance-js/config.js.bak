// priority: 1000
const killcont = new Map();
const instance = new Map();
const instancetime = new Map();

function registerDungeonRaw(name, data) {
	if (!data) return

	global.dungeonData[name] = {
		mobs: data.mobs || {},
		list: data.list || [],
		config: data.config || {}
	}
}

function notifyPlayers(level, x, y, z, radius, message) {
	x += 0.5;
	y += 0.5;
	z += 0.5;
	const aabb = createCenteredAABB(x, y, z, radius);
	level.getEntitiesWithin(aabb).forEach(entity => {
		if (entity.isPlayer()) {
			let PlayerPersistentData = entity.persistentData;
			if (PlayerPersistentData.DungeonChatLogEnabled) return
			entity.tell(message);
		}
	});
}

/** 向副本周围指定范围内的玩家同步怪物的末影饰品/等级数据（供 Jade 显示） */
function syncMobEntityDataToPlayers(level, x, y, z, radius) {
	x += 0.5;
	y += 0.5;
	z += 0.5;
	const aabb = createCenteredAABB(x, y, z, radius);
	level.getEntitiesWithin(aabb).forEach(entity => {
		if (entity.isPlayer()) {
			syncMobEntityData(entity);
		}
	});
}

